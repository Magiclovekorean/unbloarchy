#!/bin/bash

# unbloarchy:summary=Remove Tailscale and its bar plugin.
# unbloarchy:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now unbloarchy-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
unbloarchy-plugin-disable unbloarchy.tailscale
unbloarchy-webapp-remove "Tailscale" 2>/dev/null || true
unbloarchy-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
