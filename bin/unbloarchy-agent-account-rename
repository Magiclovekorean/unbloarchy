#!/bin/bash

# unbloarchy:summary=Rename a Claude or Codex subscription account
# unbloarchy:args=[claude|codex] <account> <name>
# unbloarchy:examples=unbloarchy agent account rename primary Hey | unbloarchy agent account rename codex side Side project

set -uo pipefail

# The provider can be left out when it's your default agent:
# `unbloarchy agent account rename primary Hey`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" ]]; then
  default=$(unbloarchy-default-agent)
  [[ $default == "claude" || $default == "codex" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" ]] || (( $# < 3 )); then
  echo "Usage: unbloarchy-agent-account-rename [claude|codex] <account> <name>" >&2
  exit 1
fi

account=$(unbloarchy-agent-account-state rename "$@") || exit 1
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: unbloarchy agent account use $(jq -r .id <<<"$account")"
# The panel reads account names from the usage record.
unbloarchy-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
