#!/bin/bash

# unbloarchy:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Unbloarchy default and rebuild it.
# unbloarchy:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$UNBLOARCHY_PATH/bin/unbloarchy-plymouth-set" --refresh-default
