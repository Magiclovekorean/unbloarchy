#!/bin/bash

# unbloarchy:summary=Log out after closing application windows
# unbloarchy:examples=unbloarchy logout | unbloarchy system logout
# unbloarchy:aliases=unbloarchy logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

unbloarchy-osd -i logout -m "Logging out" -d 5000

# Now close all windows
unbloarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
