#!/bin/bash

# unbloarchy:summary=Take a screenshot
# unbloarchy:group=capture
# unbloarchy:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# unbloarchy:examples=unbloarchy screenshot | unbloarchy capture screenshot region
# unbloarchy:aliases=unbloarchy screenshot

if [[ -n ${UNBLOARCHY_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$UNBLOARCHY_SCREENSHOT_DIR"
fi

omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
