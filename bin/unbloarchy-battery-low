#!/bin/bash

# unbloarchy:summary=Send the low battery warning notification and run battery-low hooks.
# unbloarchy:args=<percentage>
# unbloarchy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: unbloarchy-battery-low <percentage>" >&2
  exit 1
fi

level=$1

unbloarchy-notification-send -g 󱐋 -u normal "$(unbloarchy-i18n battery.lowTitle)" "$(unbloarchy-i18n battery.lowBody "$level")" -i battery-caution -t 30000
unbloarchy-hook battery-low "$level"
