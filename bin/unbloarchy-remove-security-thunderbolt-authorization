#!/bin/bash

# unbloarchy:summary=Restore Bolt's default authorization behavior

set -euo pipefail

gum confirm "Restore Bolt's previous policy? New accessories may be authorized automatically when IOMMU protection is active." || exit 0
sudo /usr/bin/unbloarchy-thunderbolt-authorization-admin disable
systemctl --user disable --now unbloarchy-thunderbolt-authorization.service
echo "Previous Bolt policy restored. Saved Unbloarchy trust is retained for re-enabling."
