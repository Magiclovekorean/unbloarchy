#!/bin/bash

# unbloarchy:summary=Restore Unbloarchy to the package install after reboot
# unbloarchy:group=dev
# unbloarchy:args=[--no-reboot]

set -euo pipefail

if (( EUID == 0 )); then
  echo "Error: run unbloarchy-dev-unlink as your user, not under sudo." >&2
  exit 1
fi

prompt_reboot=1

sudoers_file="/etc/sudoers.d/unbloarchy-dev-path"

if (( $# > 1 )); then
  echo "Usage: unbloarchy dev unlink [--no-reboot]" >&2
  exit 1
fi

case "${1:-}" in
  "")
    ;;
  --no-reboot)
    prompt_reboot=0
    ;;
  -h|--help)
    cat <<USAGE
Usage: unbloarchy dev unlink [--no-reboot]

Writes /etc/unbloarchy.conf so UNBLOARCHY_PATH resolves to /usr/share/unbloarchy
after reboot. This intentionally does not rewrite the running Hyprland,
systemd, shell, or app-launcher environment; reboot to make every layer agree.

Removes $sudoers_file, the drop-in that pointed sudo
at the checkout, so sudo goes back to the packaged unbloarchy-* immediately.

Use --no-reboot when another command will handle the reboot prompt.
USAGE
    exit 0
    ;;
  *)
    echo "Usage: unbloarchy dev unlink [--no-reboot]" >&2
    exit 1
    ;;
esac

default_target="/usr/share/unbloarchy"

printf 'export UNBLOARCHY_PATH="%s"\n' "$default_target" | sudo tee /etc/unbloarchy.conf >/dev/null

# unbloarchy-dev-link prepended the checkout to sudo's secure_path. Drop it in the
# same step that drops the checkout, or sudo keeps running a tree nothing else
# points at — and keeps trusting a user-writable directory for root's commands.
sudo rm -f "$sudoers_file"

echo "Pointed Unbloarchy at $default_target"
echo

if (( prompt_reboot )) && gum confirm "Reboot now to activate?"; then
  unbloarchy-system-reboot
fi
