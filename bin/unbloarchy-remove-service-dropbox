#!/bin/bash

# unbloarchy:summary=Remove Dropbox and its bar plugin.
# unbloarchy:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
unbloarchy-plugin-disable unbloarchy.dropbox
unbloarchy-pkg-drop dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo ""
echo "Dropbox has been removed."
