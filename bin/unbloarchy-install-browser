#!/bin/bash

# unbloarchy:summary=Install a supported browser
# unbloarchy:args=<chromium|chrome|brave|brave-origin|edge|firefox|zen>
# unbloarchy:examples=unbloarchy install browser chromium | unbloarchy install browser firefox

set -e

source "$UNBLOARCHY_PATH/install/helpers/browser-policy.sh"

opt_path="${UNBLOARCHY_OPT_PATH:-/opt}"

setup_chromium_policy_directory() {
  browser_policy_setup_dir "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

# The widevine package registers its CDM for Chromium and Firefox only; Brave
# looks for one in its own install directory.
link_widevine_cdm() {
  local cdm="$opt_path/WidevineCdm/chromium"
  local install_dir="$opt_path/$1"

  if [[ -d $cdm && -d $install_dir && ! -e $install_dir/WidevineCdm ]]; then
    as_root ln -sfn "$cdm" "$install_dir/WidevineCdm"
  fi
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "$UNBLOARCHY_PATH/config/chromium-flags.conf" "$1"
  unbloarchy-install-chromium-copy-url
  unbloarchy-install-chromium-ytdlp
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/unbloarchy-firefox-wayland.conf
}

case $1 in
chromium)
  echo "Installing Chromium..."
  unbloarchy-pkg-add chromium

  setup_chromium_policy_directory /etc/chromium/policies/managed
  copy_chromium_flags ~/.config/chromium-flags.conf
  unbloarchy-theme-set-browser
  unbloarchy-lifecycle-dispatch post-install chromium
  announce_browser_installed "Chromium"
  ;;
chrome)
  echo "Installing Chrome..."
  unbloarchy-pkg-aur-add google-chrome || exit 1

  setup_chromium_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  unbloarchy-theme-set-browser
  unbloarchy-lifecycle-dispatch post-install chrome
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  unbloarchy-pkg-aur-add microsoft-edge-stable-bin || exit 1

  setup_chromium_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  unbloarchy-theme-set-browser
  unbloarchy-lifecycle-dispatch post-install edge
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  unbloarchy-pkg-aur-add brave-bin || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  link_widevine_cdm brave-bin
  unbloarchy-theme-set-browser
  unbloarchy-lifecycle-dispatch post-install brave
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  unbloarchy-pkg-aur-add brave-origin-bin || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-origin-flags.conf
  link_widevine_cdm brave-origin-bin
  unbloarchy-theme-set-browser
  unbloarchy-lifecycle-dispatch post-install brave-origin
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  unbloarchy-pkg-add firefox || exit 1

  browser_policy_setup_firefox_distribution /usr/lib/firefox/distribution
  setup_firefox_wayland
  unbloarchy-lifecycle-dispatch post-install firefox
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  unbloarchy-pkg-aur-add zen-browser-bin || exit 1

  browser_policy_setup_firefox_distribution /opt/zen-browser/distribution
  setup_firefox_wayland
  unbloarchy-lifecycle-dispatch post-install zen
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: unbloarchy-install-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
