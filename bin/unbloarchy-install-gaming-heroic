#!/bin/bash

# unbloarchy:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# unbloarchy:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
unbloarchy-pkg-add heroic-games-launcher-bin
unbloarchy-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
