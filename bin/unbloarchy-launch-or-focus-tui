#!/bin/bash

# unbloarchy:summary=Launch a TUI or focus an existing terminal window for it
# unbloarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.unbloarchy.$(basename "$1")"
fi

LAUNCH_COMMAND="unbloarchy-launch-tui $@"

exec unbloarchy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
