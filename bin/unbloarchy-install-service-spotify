#!/bin/bash

# unbloarchy:summary=Install Spotify, as its web player where Spotify has no Linux client.
# unbloarchy:requires-sudo=true

set -e

if unbloarchy-hw-x86; then
  echo "Installing Spotify..."
  unbloarchy-pkg-add spotify

  echo "Opening Spotify..."
  setsid uwsm-app -- /usr/bin/spotify >/dev/null 2>&1 &
else
  # Spotify builds its Linux client for x86_64 only (its repository serves amd64
  # and i386), so ARM gets the web player, which Chromium plays with the Widevine
  # module it fetches itself.
  echo "Installing Spotify as a web app..."
  unbloarchy-webapp-install "Spotify" "https://open.spotify.com/" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/spotify.png"

  echo "Opening Spotify..."
  setsid unbloarchy-launch-webapp "https://open.spotify.com/" >/dev/null 2>&1 &
fi

echo ""
echo "Spotify has been installed."
