#!/bin/bash

# unbloarchy:summary=Reinstall all default Unbloarchy packages from the stable channel, or on Apple Silicon the edge channel
# unbloarchy:requires-sudo=true

set -e

# Reinstall all default Unbloarchy packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$UNBLOARCHY_PATH/install/helpers/pacman.sh"
platform=$(unbloarchy-hw-platform)
channel=$(unbloarchy_pacman_default_channel "$platform")
unbloarchy-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
unbloarchy-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(unbloarchy-pkg-defaults)
mapfile -t packages <<<"$default_packages"
# --ask 4 accepts removing a stock package a default replaces, such as
# power-profiles-daemon for unbloarchy-power-profiles-daemon.
unbloarchy-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
