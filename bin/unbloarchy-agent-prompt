#!/bin/bash

# unbloarchy:summary=Launch the default coding agent with a prompt
# unbloarchy:args=[--inline] <prompt...>
# unbloarchy:examples=unbloarchy agent prompt "Review this project"

# Prompts live here rather than on `unbloarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: unbloarchy agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec unbloarchy-agent "${inline[@]}" --prompt "$*"
