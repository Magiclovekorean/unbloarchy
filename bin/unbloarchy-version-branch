#!/bin/bash

# unbloarchy:summary=Print the active Unbloarchy dev-link git branch
# unbloarchy:hidden=true

unbloarchy_path=${UNBLOARCHY_PATH:-/usr/share/unbloarchy}
unbloarchy_path=${unbloarchy_path%/}

[[ $unbloarchy_path != "/usr/share/unbloarchy" ]] || exit 1

branch=$(git -C "$unbloarchy_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$unbloarchy_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
