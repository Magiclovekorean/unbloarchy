#!/bin/bash

# unbloarchy:hidden=true
# unbloarchy:summary=Provide internal helpers for command-scoped sudo authentication

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  echo "unbloarchy-security-functions is an internal function library." >&2
  exit 64
fi

unbloarchy_security_require_privileged_bash_startup() {
  [[ $- == *p* ]] || return 1
  /usr/bin/env -i /usr/bin/bash -p -c '
    mapfile -d "" -t argv <"/proc/$1/cmdline" || exit 1
    executable=$(/usr/bin/readlink -e -- "/proc/$1/exe") || exit 1
    [[ $executable == "/usr/bin/bash" &&
      ( ${argv[0]:-} == "/bin/bash" || ${argv[0]:-} == "/usr/bin/bash" ) &&
      ${argv[1]:-} == "-p" ]]
  ' unbloarchy-bash-startup "$$"
}

unbloarchy_security_sanitize_bash_environment() {
  local script=$1
  shift
  local entry name environment_fd environment_pid
  local -a unsets=()

  # Read the raw environment: privileged Bash ignores exported functions, but
  # leaves their records for ordinary child interpreters to import later.
  exec {environment_fd}< <(/usr/bin/env -0)
  environment_pid=$!
  while IFS= read -r -d '' entry <&"$environment_fd"; do
    name=${entry%%=*}
    case "$name" in
      BASH_ENV|ENV|SHELLOPTS|BASHOPTS|PS4|CDPATH|GLOBIGNORE|BASH_FUNC_*%%)
        unsets+=(-u "$name")
        ;;
    esac
  done
  exec {environment_fd}<&-
  wait "$environment_pid" || return 1
  if (( ${#unsets[@]} > 0 )); then
    exec /usr/bin/env "${unsets[@]}" /usr/bin/bash -p -- "$script" "$@"
  fi
}

unbloarchy_security_require_source_root() {
  local command_source command_name=${1##*/} root resolved_root ok=1

  command_source=$(/usr/bin/readlink -e -- "$1") || ok=0
  root=${UNBLOARCHY_PATH:-}
  [[ $root == /* ]] || ok=0
  if (( ok )); then
    resolved_root=$(/usr/bin/realpath -e -- "$root") || ok=0
  fi

  # A dev checkout must name itself canonically, without symlinks, so a moved
  # or attacker-placed tree is never invoked by a stale UNBLOARCHY_PATH. The
  # renamed system package root is the exception: compat-links.sh keeps
  # /usr/share/unbloarchy as a symlink to the package-owned /usr/share/omarchy
  # tree, so the two package literals are accepted only when they resolve back
  # onto one of those roots.
  if (( ok )); then
    if [[ $root != "/usr/share/unbloarchy" && $root != "/usr/share/omarchy" ]]; then
      [[ $resolved_root == "$root" ]] || ok=0
    elif [[ $resolved_root != "/usr/share/unbloarchy" && $resolved_root != "/usr/share/omarchy" ]]; then
      ok=0
    fi
  fi

  # The command must come from the runtime root it declares: the checkout's own
  # bin/, or the packaged /usr/bin wrapper (which the package tree's bin/ links
  # back to).
  if (( ok )); then
    if [[ $resolved_root == "/usr/share/unbloarchy" || $resolved_root == "/usr/share/omarchy" ]]; then
      [[ $command_source == "/usr/bin/$command_name" ||
        $command_source == "$resolved_root/bin/$command_name" ]] || ok=0
    else
      [[ $command_source == "$root/bin/$command_name" ]] || ok=0
    fi
  fi

  if ! (( ok )); then
    echo "UNBLOARCHY_PATH does not match this Unbloarchy command." >&2
    return 1
  fi
}

unbloarchy_security_sudo_supports_no_update() {
  local help
  help=$(LC_ALL=C /usr/bin/sudo -h 2>&1) || return 1
  /usr/bin/grep -Eq '^usage: sudo .*\[[^]]*N[^]]*\]' <<< "$help"
}

unbloarchy_security_revoke_sudo_timestamp() {
  /usr/bin/sudo -k
}

unbloarchy_security_exit_with_revoked_sudo() {
  local status=$1
  local message=${2:-Could not invalidate cached sudo authorization.}

  trap - EXIT HUP INT TERM
  if ! unbloarchy_security_revoke_sudo_timestamp; then
    echo "$message" >&2
    (( status != 0 )) || status=1
  fi
  exit "$status"
}

unbloarchy_security_install_signal_exit_traps() {
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

unbloarchy_security_install_sudo_cleanup_traps() {
  UNBLOARCHY_SECURITY_SUDO_CLEANUP_MESSAGE=${1:-Could not invalidate cached sudo authorization.}
  trap unbloarchy_security_run_sudo_cleanup_trap EXIT
  unbloarchy_security_install_signal_exit_traps
}

unbloarchy_security_enable_no_update_sudo() {
  local wrapper_dir="$UNBLOARCHY_PATH/default/unbloarchy/sudo-no-update"
  if ! unbloarchy_security_sudo_supports_no_update; then
    echo "This sudo does not support --no-update; refusing mixed-trust work." >&2
    return 1
  fi
  if [[ ! -f $wrapper_dir/sudo || ! -x $wrapper_dir/sudo ]]; then
    echo "The command-scoped sudo wrapper is missing." >&2
    return 1
  fi
  PATH="$wrapper_dir:$UNBLOARCHY_PATH/bin:/usr/bin:/usr/sbin:/bin:/sbin"
  UNBLOARCHY_SUDO_NO_UPDATE=1
  export PATH UNBLOARCHY_SUDO_NO_UPDATE
}

unbloarchy_security_run_sudo_cleanup_trap() {
  local status=$?

  unbloarchy_security_exit_with_revoked_sudo "$status" \
    "${UNBLOARCHY_SECURITY_SUDO_CLEANUP_MESSAGE:-Could not invalidate cached sudo authorization.}"
}

unbloarchy_security_assert_root_directory() {
  local path=$1 expected_mode=$2 canonical owner actual_mode

  [[ $path == /* && -d $path && ! -L $path ]] || return 1
  canonical=$(/usr/bin/realpath -e -- "$path") || return 1
  [[ $canonical == "$path" ]] || return 1
  read -r owner actual_mode < <(/usr/bin/stat -Lc '%u %a' -- "$path") || return 1
  [[ $owner == "0" && $actual_mode == "$expected_mode" ]]
}

unbloarchy_security_prepare_private_root_directory() {
  local path=$1 parent=$2

  unbloarchy_security_assert_root_directory "$parent" 755 || return 1
  if [[ -e $path || -L $path ]]; then
    unbloarchy_security_assert_root_directory "$path" 700
  else
    /usr/bin/install -d -o root -g root -m 0700 -- "$path" || return 1
    unbloarchy_security_assert_root_directory "$path" 700
  fi
}
