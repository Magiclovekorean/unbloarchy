#!/bin/bash

# unbloarchy:summary=Select and set the system timezone
# unbloarchy:group=menu
# unbloarchy:name=timezone

set -e

timezone=$(timedatectl list-timezones | unbloarchy-menu-select "$(unbloarchy-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
unbloarchy-shell -q unbloarchy.clock refresh
unbloarchy-notification-send "$(unbloarchy-i18n timezone.changed "$timezone")"
