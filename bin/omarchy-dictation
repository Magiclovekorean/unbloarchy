#!/bin/bash

# unbloarchy:summary=Record dictation with the configured backend
# unbloarchy:args=<start|stop|toggle>
# unbloarchy:examples=unbloarchy dictation start | unbloarchy dictation toggle

if (($# != 1)) || [[ $1 != "start" && $1 != "stop" && $1 != "toggle" ]]; then
  echo "Usage: unbloarchy dictation <start|stop|toggle>" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/unbloarchy/defaults/dictation"
mkdir -p "${config%/*}"
exec 9> "$config.lock"
if ! flock -w 5 9; then
  echo "Dictation is busy; try again." >&2
  exit 1
fi

backend=$(unbloarchy-default-dictation) || exit 1
adapter="unbloarchy-dictation-$backend"
if unbloarchy-cmd-missing "$adapter"; then
  echo "The selected dictation backend ($backend) is not installed." >&2
  exit 1
fi
"$adapter" "$1" 9>&-
