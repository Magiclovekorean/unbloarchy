#!/bin/bash

# unbloarchy:summary=Toggle screensaver availability

unbloarchy-toggle screensaver-off

if unbloarchy-toggle-enabled screensaver-off; then
  unbloarchy-notification-send -g 󱄄 "$(unbloarchy-i18n screensaver.disabled)"
else
  unbloarchy-notification-send -g 󱄄 "$(unbloarchy-i18n screensaver.enabled)"
fi
