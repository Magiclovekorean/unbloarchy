#!/bin/bash

# unbloarchy:summary=List themes that can style the Plymouth boot screen
# unbloarchy:examples=unbloarchy plymouth list

{
  find ~/.config/unbloarchy/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$UNBLOARCHY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(unbloarchy-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
