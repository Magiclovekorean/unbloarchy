#!/bin/bash

# unbloarchy:summary=Cache background switcher thumbnails for the current theme

theme_name=$(cat "$HOME/.local/state/unbloarchy/current/theme.name" 2>/dev/null)

unbloarchy-menu-images \
  --cache-only \
  "$HOME/.local/state/unbloarchy/current/theme/backgrounds" \
  "$HOME/.config/unbloarchy/backgrounds/$theme_name"
