#!/bin/bash

# unbloarchy:summary=Open the Unbloarchy Discord community in the Discord app or a browser.

invite="https://discord.gg/tXFUdasqhY"

if unbloarchy-cmd-present discord; then
  exec setsid uwsm-app -- discord --url -- "discord://-/invite/${invite##*/}"
else
  exec unbloarchy-launch-webapp "$invite"
fi
