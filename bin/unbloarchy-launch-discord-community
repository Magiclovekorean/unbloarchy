#!/bin/bash

# unbloarchy:summary=Open the upstream Omarchy community Discord

# Omarchy's invite, not a Unbloarchy-run server. The menu still offers it because
# it is where Unbloarchy users end up, so it is labelled as upstream's rather
# than silently rebranded — and not pointed at an invented URL either.
invite="https://discord.gg/tXFUdasqhY"

if unbloarchy-cmd-present discord; then
  exec setsid uwsm-app -- discord --url -- "discord://-/invite/${invite##*/}"
else
  exec unbloarchy-launch-webapp "$invite"
fi
