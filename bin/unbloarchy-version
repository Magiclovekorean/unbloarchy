#!/bin/bash

# unbloarchy:summary=Print the installed Unbloarchy version

unbloarchy_path=${UNBLOARCHY_PATH:-/usr/share/unbloarchy}
unbloarchy_path=${unbloarchy_path%/}

if [[ $unbloarchy_path != "/usr/share/unbloarchy" ]]; then
  hash=$(git -C "$unbloarchy_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The edge channel installs omarchy-dev instead of omarchy, so check both.
for package in omarchy-dev omarchy; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || exit 1

echo "$version"
