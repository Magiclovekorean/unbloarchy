#!/bin/bash

# unbloarchy:summary=Reinstall Unbloarchy packages and reset default configs
# unbloarchy:requires-sudo=true

set -e

echo -e "This will reinstall all default Unbloarchy packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  unbloarchy-reinstall-pkgs
  unbloarchy-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && unbloarchy-system-reboot
fi
