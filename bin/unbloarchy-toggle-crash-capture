#!/bin/bash

# unbloarchy:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

unbloarchy-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if unbloarchy-toggle-enabled crash-capture-off; then
  systemctl --user stop unbloarchy-crash-watch.service
  unbloarchy-notification-send -g "$CRASH_GLYPH" "Crash capture disabled"
else
  systemctl --user start unbloarchy-crash-watch.service
  unbloarchy-notification-send -g "$CRASH_GLYPH" "Crash capture enabled"
fi
