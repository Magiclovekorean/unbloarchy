#!/bin/bash

# unbloarchy:summary=Prompt for confirmation before starting an update

gum style --border normal --padding "1 2" \
  "$(unbloarchy-i18n update.ready)" \
  "" \
  "• $(unbloarchy-i18n update.cannotStop)" \
  "• $(unbloarchy-i18n update.connectPower)" \
  "" \
  "$(unbloarchy-i18n update.whatsNew "https://github.com/Magiclovekorean/unbloarchy/releases/latest")"

echo

if ! gum confirm --affirmative "$(unbloarchy-i18n common.yes)" --negative "$(unbloarchy-i18n common.no)" "$(unbloarchy-i18n update.continue)"; then
  echo "Update cancelled"
  exit 1
fi
