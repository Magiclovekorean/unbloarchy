#!/bin/bash

# unbloarchy:summary=Update the active Unbloarchy dev checkout

set -euo pipefail

[[ $UNBLOARCHY_PATH != "/usr/share/unbloarchy" ]] || exit 0

if ! git -C "$UNBLOARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: UNBLOARCHY_PATH is not a git checkout: $UNBLOARCHY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$UNBLOARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Unbloarchy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Unbloarchy dev checkout\e[0m"
git -C "$UNBLOARCHY_PATH" pull --ff-only
