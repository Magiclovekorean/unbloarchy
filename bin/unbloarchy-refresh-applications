#!/bin/bash

# unbloarchy:summary=Ensure default application launchers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$OMARCHY_PATH"/applications/*.desktop ~/.local/share/applications/

if unbloarchy-cmd-present alacritty; then
  cp "$UNBLOARCHY_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

update-desktop-database ~/.local/share/applications
