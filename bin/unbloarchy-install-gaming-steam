#!/bin/bash

# unbloarchy:summary=Install Steam and graphics drivers selected for this system
# unbloarchy:requires-sudo=true

set -e

echo "Installing Steam..."
unbloarchy-pkg-add steam
unbloarchy-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
