#!/bin/bash

# unbloarchy:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# unbloarchy:args=[toggle|on|off]
# unbloarchy:examples=unbloarchy toggle fullscreen desktop | unbloarchy toggle fullscreen desktop off | unbloarchy toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if unbloarchy-toggle-enabled bar-off && unbloarchy-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: unbloarchy-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

unbloarchy-toggle-bar "$ACTION"
unbloarchy-hyprland-toggle window-no-gaps "$ACTION"
