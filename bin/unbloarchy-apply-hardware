#!/bin/bash

# unbloarchy:summary=Apply Unbloarchy hardware-specific packages and system configuration
# unbloarchy:group=apply
# unbloarchy:requires-sudo=true
# unbloarchy:examples=unbloarchy apply hardware --install-user dhh
# unbloarchy:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: unbloarchy apply hardware --install-user USER
       unbloarchy apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by unbloarchy-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/unbloarchy/provisioning/groups.
USAGE
}

install_user="${UNBLOARCHY_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: unbloarchy-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export UNBLOARCHY_INSTALL_USER="$install_user"
export UNBLOARCHY_PATH="${UNBLOARCHY_PATH:-/usr/share/unbloarchy}"
export UNBLOARCHY_INSTALL="${UNBLOARCHY_INSTALL:-$UNBLOARCHY_PATH/install}"
export UNBLOARCHY_INSTALL_LOG_FILE="${UNBLOARCHY_INSTALL_LOG_FILE:-/var/log/unbloarchy-install.log}"
export PATH="$UNBLOARCHY_PATH/bin:$PATH"

source "$UNBLOARCHY_INSTALL/helpers/logging.sh"
source "$UNBLOARCHY_INSTALL/hardware/all.sh"
