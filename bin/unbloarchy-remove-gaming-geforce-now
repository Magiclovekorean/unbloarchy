#!/bin/bash

# unbloarchy:summary=Remove the GeForce NOW Flatpak app and its data.
# unbloarchy:group=remove
# unbloarchy:name=gaming geforce-now

set -e

if unbloarchy-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
