#!/bin/bash

# unbloarchy:summary=Restore the preinstalled Unbloarchy applications (web apps, TUIs, and selected packages).
# unbloarchy:requires-sudo=true

if gum confirm --affirmative "$(unbloarchy-i18n common.yes)" --negative "$(unbloarchy-i18n common.no)" "$(unbloarchy-i18n preinstalls.confirmRestore)"; then
  echo -e "Restoring preinstalled Unbloarchy applications...\n"

  # Recreates the shipped .desktop launchers (web apps and TUIs).
  unbloarchy-refresh-applications || exit 1

  # Re-enable Unbloarchy's default mise tools for this user and rebuild their shims.
  if ! unbloarchy-mise-default-tools enable; then
    echo -e "\nCould not restore mise tools. Preinstalls remain marked as removed."
    exit 1
  fi

  # Mirrors the list in unbloarchy-remove-preinstalls; both track unbloarchy-base.packages
  if ! unbloarchy-pkg-add \
    aether \
    cliamp \
    libreoffice-fresh \
    pinta \
    obsidian \
    moonlight-qt \
    omacut \
    monologue \
    omacalc \
    omawrite \
    hype \
    signed; then
    echo -e "\nPreinstalls are still marked as removed. Fix the errors above and try again."
    exit 1
  fi

  # Last, so a failure above leaves the opt-out intact rather than restoring
  # keybindings for apps that never came back
  rm -f ~/.local/state/unbloarchy/preinstalls-removed
  hyprctl reload
fi
