#!/bin/bash

# unbloarchy:summary=Print the directory holding a theme, preferring a user-installed copy
# unbloarchy:args=<theme-name>
# unbloarchy:examples=unbloarchy theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: unbloarchy-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/unbloarchy/themes/$theme ]]; then
  echo "$HOME/.config/unbloarchy/themes/$theme"
else
  echo "$UNBLOARCHY_PATH/themes/$theme"
fi
