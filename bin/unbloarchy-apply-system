#!/bin/bash

# unbloarchy:summary=Apply Unbloarchy system setup in the installed target
# unbloarchy:group=apply
# unbloarchy:requires-sudo=true
# unbloarchy:examples=unbloarchy apply system --install-user dhh --first-install
# unbloarchy:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: unbloarchy apply system --install-user USER [--first-install|--upgrade]
       unbloarchy apply system --defer-provisioning --first-install

Runs root-owned Unbloarchy system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
unbloarchy-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/unbloarchy/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${UNBLOARCHY_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: unbloarchy-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export UNBLOARCHY_INSTALL_USER="$install_user"
export UNBLOARCHY_FIRST_INSTALL="$first_install"
export UNBLOARCHY_UPGRADE="$upgrade"
export UNBLOARCHY_PATH="${UNBLOARCHY_PATH:-/usr/share/unbloarchy}"
export UNBLOARCHY_INSTALL="${UNBLOARCHY_INSTALL:-$UNBLOARCHY_PATH/install}"
export UNBLOARCHY_INSTALL_LOG_FILE="${UNBLOARCHY_INSTALL_LOG_FILE:-/var/log/unbloarchy-install.log}"
export PATH="$UNBLOARCHY_PATH/bin:$PATH"

source "$UNBLOARCHY_INSTALL/helpers/logging.sh"
start_install_log

source "$UNBLOARCHY_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  unbloarchy-apply-hardware --defer-provisioning
else
  unbloarchy-apply-hardware --install-user "$install_user"
fi

source "$UNBLOARCHY_INSTALL/login/all.sh"
source "$UNBLOARCHY_INSTALL/post-install/all.sh"

stop_install_log
