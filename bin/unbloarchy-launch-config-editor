#!/bin/bash

# unbloarchy:summary=Open a config file in the user's editor and surface a toast
# unbloarchy:args=<path>
# unbloarchy:examples=unbloarchy launch config-editor ~/.config/hypr/hyprland.lua

path="${1-}"

if [[ -z $path ]]; then
  echo "Usage: unbloarchy-launch-config-editor <path>" >&2
  exit 1
fi

unbloarchy-notification-send -u low "Editing config file" "$path"
exec unbloarchy-launch-editor "$path"
