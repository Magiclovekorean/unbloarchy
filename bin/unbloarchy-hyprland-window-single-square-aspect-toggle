#!/bin/bash

# unbloarchy:summary=Toggle single-window square aspect ratio.

case $(unbloarchy-hyprland-toggle single-window-aspect-ratio) in
  on) unbloarchy-notification-send -g  "$(unbloarchy-i18n window.squareOn)" ;;
  off) unbloarchy-notification-send -g  "$(unbloarchy-i18n window.squareOff)" ;;
esac
