#!/bin/bash

# unbloarchy:summary=Remove Steam and all of its game libraries, configs, and caches.
# unbloarchy:requires-sudo=true

set -e

unbloarchy-lifecycle-dispatch pre-remove steam
unbloarchy-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
