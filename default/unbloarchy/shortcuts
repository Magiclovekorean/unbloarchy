# Hyprland global shortcuts the Unbloarchy shell registers, one per line: a menu
# route to toggle, a panel plugin to toggle, a volume or brightness key, or an
# argument-free IPC call as target.method. A binding written as o.bind(keys,
# description, { menu = "theme" }), { panel = "unbloarchy.emojis" },
# { audio = "raise" }, { brightness = "raise" } or { ipc = "media.next" }
# dispatches the matching shortcut straight to the shell, with no process to
# spawn per keypress. Anything missing here still binds, through the
# unbloarchy-menu, unbloarchy-shell, unbloarchy-audio-output-volume or
# unbloarchy-brightness-display command instead.
menu root
menu apps
menu capture
menu toggle
menu hardware
menu system
menu background
menu theme
menu share
menu reminder-set
panel unbloarchy.clipboard
panel unbloarchy.emojis
panel unbloarchy.audio
panel unbloarchy.bluetooth
panel unbloarchy.monitor
panel unbloarchy.clock
panel unbloarchy.elsewhen
panel unbloarchy.network
panel unbloarchy.power
audio raise
audio lower
audio mute-toggle
brightness raise
brightness lower
ipc media.playPause
ipc media.next
ipc media.previous
ipc notifications.dismissOne
ipc notifications.dismissAll
ipc notifications.invokeLast
ipc notifications.showHistory
