# Single source of truth for UNBLOARCHY_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/unbloarchy.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-unbloarchy          (Hyprland session via uwsm)
#   /usr/share/unbloarchy/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/unbloarchy.conf is written by unbloarchy-dev-link and reset by
# unbloarchy-dev-unlink. During the package-name-preserving transition, the
# upstream package still owns /usr/share/omarchy and existing dev links still
# use /etc/omarchy.conf.
UNBLOARCHY_PACKAGED_PATH=/usr/share/unbloarchy
if [ ! -d "$UNBLOARCHY_PACKAGED_PATH/default" ] &&
  [ -d /usr/share/omarchy/default ]; then
  UNBLOARCHY_PACKAGED_PATH=/usr/share/omarchy
fi

if [ -f /etc/unbloarchy.conf ]; then
  . /etc/unbloarchy.conf
  : "${UNBLOARCHY_PATH:=$UNBLOARCHY_PACKAGED_PATH}"
elif [ -f /etc/omarchy.conf ]; then
  . /etc/omarchy.conf
  : "${UNBLOARCHY_PATH:=${OMARCHY_PATH:-$UNBLOARCHY_PACKAGED_PATH}}"
else
  : "${UNBLOARCHY_PATH:=${OMARCHY_PATH:-$UNBLOARCHY_PACKAGED_PATH}}"
fi

if [ "$UNBLOARCHY_PATH" = /usr/share/unbloarchy ] &&
  [ ! -d "$UNBLOARCHY_PATH/default" ] &&
  [ -d /usr/share/omarchy/default ]; then
  UNBLOARCHY_PATH=/usr/share/omarchy
fi
export UNBLOARCHY_PATH
unset UNBLOARCHY_PACKAGED_PATH

# Deprecated alias. Pre-rename software and user dotfiles still read OMARCHY_PATH,
# so it always mirrors UNBLOARCHY_PATH. Never let the two diverge: new code reads
# UNBLOARCHY_PATH only, and nothing should treat this as an independent input.
OMARCHY_PATH=$UNBLOARCHY_PATH
export OMARCHY_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/unbloarchy-* via the unbloarchy package — prepending
# /usr/share/unbloarchy/bin would just be noise.
if [ "$UNBLOARCHY_PATH" != /usr/share/unbloarchy ] &&
  [ "$UNBLOARCHY_PATH" != /usr/share/omarchy ]; then
  case ":$PATH:" in
    *":${UNBLOARCHY_PATH%/}/bin:"*) ;;
    *) PATH="${UNBLOARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
unbloarchy_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
unbloarchy_wrapper_path=$unbloarchy_wrapper_dir
if [ -n "${PATH:-}" ]; then
  unbloarchy_remaining_path=$PATH
  while :; do
    unbloarchy_path_entry=${unbloarchy_remaining_path%%:*}
    if [ "$unbloarchy_path_entry" != "$unbloarchy_wrapper_dir" ]; then
      unbloarchy_wrapper_path="$unbloarchy_wrapper_path:$unbloarchy_path_entry"
    fi
    case "$unbloarchy_remaining_path" in
      *:*) unbloarchy_remaining_path=${unbloarchy_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$unbloarchy_wrapper_path
unset unbloarchy_wrapper_dir unbloarchy_wrapper_path unbloarchy_remaining_path unbloarchy_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
