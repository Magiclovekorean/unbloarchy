: "${UNBLOARCHY_PATH:=/usr/share/unbloarchy}"
source "$UNBLOARCHY_PATH/default/bash/envs"
source "$UNBLOARCHY_PATH/default/bash/shell"
source "$UNBLOARCHY_PATH/default/bash/aliases"
source "$UNBLOARCHY_PATH/default/bash/functions"
source "$UNBLOARCHY_PATH/default/bash/init"
[[ $- == *i* ]] && bind -f "$UNBLOARCHY_PATH/default/bash/inputrc"
